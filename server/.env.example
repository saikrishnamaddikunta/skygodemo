NODE_ENV=development
PORT=5050

FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

MAPS_PROVIDER=openstreetmap_osrm
MAPS_API_KEY=pk.skygo_osm_osrm_carto_public_v1_verified
MAPS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAPS_ROUTING_API_URL=https://router.project-osrm.org/route/v1
MAPS_GEOCODING_API_URL=https://nominatim.openstreetmap.org

JWT_SECRET=dev-omnitransit-jwt-secret-change-in-production-min-32-chars

DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

BASE_CARBON_REWARD_RATE=10
MAX_DAILY_CARBON_REWARDS=500

LOCATION_UPDATE_INTERVAL_SECONDS=15

LOG_LEVEL=info
