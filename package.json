{
  "name": "skygo",
  "version": "1.0.0",
  "private": true,
  "description": "SKYGO — AI-Powered Smart Mobility, Multi-Modal Efficiency, Fleet Optimization & Night Safety Platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "postinstall": "npm --workspace=shared run build",
    "dev": "node scripts/dev.js",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build:shared": "npm --workspace=shared run build",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "start": "npm --workspace=server run start",
    "db:migrate": "npm --workspace=server run db:migrate",
    "test": "npm --workspace=server run test"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
